{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinyedge.ai/schemas/runtime/runtime-telemetry-v1.schema.json",
  "title": "TinyEdge Runtime telemetry summary v1",
  "description": "Structural projection of the bounded, payload-free TinyEdge Runtime v1 telemetry summary.",
  "$comment": "This schema is a portable structural projection. The tinyedge_runtime Python parser remains authoritative for counter relationships, stop-summary consistency, and all semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "plan_hash",
    "state",
    "steps_attempted",
    "steps_succeeded",
    "rejected_actions",
    "stale_observations",
    "safe_stop_count",
    "safe_stop_confirmed",
    "last_stop_reason",
    "cleanup_failures",
    "last_observation_age_ns",
    "last_action_age_ns",
    "last_inference_ns"
  ],
  "properties": {
    "contract_version": {
      "const": "tinyedge-runtime-telemetry-v1"
    },
    "plan_hash": {
      "$ref": "#/$defs/digest"
    },
    "state": {
      "enum": [
        "validated",
        "prepared",
        "armed",
        "running",
        "safe_stopped",
        "closed"
      ]
    },
    "steps_attempted": {
      "$ref": "#/$defs/nonnegativeInteger"
    },
    "steps_succeeded": {
      "$ref": "#/$defs/nonnegativeInteger"
    },
    "rejected_actions": {
      "$ref": "#/$defs/nonnegativeInteger"
    },
    "stale_observations": {
      "$ref": "#/$defs/nonnegativeInteger"
    },
    "safe_stop_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "safe_stop_confirmed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "last_stop_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "cleanup_failures": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "last_observation_age_ns": {
      "$ref": "#/$defs/optionalNonnegativeInteger"
    },
    "last_action_age_ns": {
      "$ref": "#/$defs/optionalNonnegativeInteger"
    },
    "last_inference_ns": {
      "$ref": "#/$defs/optionalNonnegativeInteger"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "optionalNonnegativeInteger": {
      "anyOf": [
        {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
