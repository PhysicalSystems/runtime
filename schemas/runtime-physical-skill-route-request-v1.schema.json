{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinyedge.ai/schemas/runtime/runtime-physical-skill-route-request-v1.schema.json",
  "title": "TinyEdge Runtime physical skill route request v1",
  "description": "Structural projection of one sealed point-in-time physical skill route request.",
  "$comment": "This schema is a portable structural projection. The tinyedge_runtime Python parser remains authoritative for canonical ordering, uniqueness, typed invocation and nested policy hashes, precondition evidence semantics, and request-digest verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "catalog_digest",
    "skill_id",
    "skill_definition_digest",
    "arguments",
    "invocation_digest",
    "workcell_id",
    "workcell_digest",
    "manifest_digest",
    "state_digest",
    "evaluation_monotonic_ns",
    "dependency_bindings",
    "calibration_bindings",
    "artifact_bindings",
    "qualification_bindings",
    "execution_targets",
    "preconditions",
    "policy",
    "request_digest"
  ],
  "properties": {
    "contract_version": {"const": "tinyedge-runtime-physical-skill-route-request-v1"},
    "request_id": {"$ref": "#/$defs/identifier"},
    "catalog_digest": {"$ref": "#/$defs/digest"},
    "skill_id": {"$ref": "#/$defs/identifier"},
    "skill_definition_digest": {"$ref": "#/$defs/digest"},
    "arguments": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/argument"}
    },
    "invocation_digest": {"$ref": "#/$defs/digest"},
    "workcell_id": {"$ref": "#/$defs/identifier"},
    "workcell_digest": {"$ref": "#/$defs/digest"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "state_digest": {"$ref": "#/$defs/digest"},
    "evaluation_monotonic_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "dependency_bindings": {"$ref": "#/$defs/bindingVector"},
    "calibration_bindings": {"$ref": "#/$defs/bindingVector"},
    "artifact_bindings": {"$ref": "#/$defs/bindingVector"},
    "qualification_bindings": {"$ref": "#/$defs/bindingVector"},
    "execution_targets": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/executionTarget"}
    },
    "preconditions": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/assessment"}
    },
    "policy": {"$ref": "#/$defs/policy"},
    "request_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scalarValue": {
      "type": ["boolean", "integer", "number", "string"],
      "minimum": -1000000000000,
      "maximum": 1000000000000,
      "minLength": 1,
      "maxLength": 512
    },
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value_type", "value"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "value_type": {
          "enum": ["boolean", "integer", "number", "string", "identifier", "digest"]
        },
        "value": {"$ref": "#/$defs/scalarValue"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "kind", "digest"],
      "properties": {
        "binding_id": {"$ref": "#/$defs/identifier"},
        "kind": {"$ref": "#/$defs/identifier"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "bindingVector": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/binding"}
    },
    "executionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest"],
      "properties": {
        "kind": {"$ref": "#/$defs/identifier"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precondition_id",
        "requirement_digest",
        "invocation_digest",
        "status",
        "state_digest",
        "observed_monotonic_ns",
        "evidence_digest"
      ],
      "properties": {
        "precondition_id": {"$ref": "#/$defs/identifier"},
        "requirement_digest": {"$ref": "#/$defs/digest"},
        "invocation_digest": {"$ref": "#/$defs/digest"},
        "status": {"enum": ["met", "violated", "unknown"]},
        "state_digest": {"$ref": "#/$defs/digest"},
        "observed_monotonic_ns": {
          "anyOf": [
            {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
            {"type": "null"}
          ]
        },
        "evidence_digest": {
          "anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "implementation_order",
        "allowed_qualification_statuses",
        "policy_digest"
      ],
      "properties": {
        "policy_id": {"$ref": "#/$defs/identifier"},
        "implementation_order": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "allowed_qualification_statuses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["qualified", "demo_qualified", "provisional"]}
        },
        "policy_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
