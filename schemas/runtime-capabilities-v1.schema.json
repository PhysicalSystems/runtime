{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinyedge.ai/schemas/runtime/runtime-capabilities-v1.schema.json",
  "title": "TinyEdge Runtime capabilities v1",
  "description": "Structural projection of the TinyEdge Runtime v1 capability attestation.",
  "$comment": "This schema is a portable structural projection. The tinyedge_runtime Python parser remains authoritative for canonical ordering, identity uniqueness, cross-field relationships, and capability-digest verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "device_id",
    "environment_id",
    "adapters",
    "qualified_bundles",
    "capability_digest"
  ],
  "properties": {
    "contract_version": {
      "const": "tinyedge-runtime-capabilities-v1"
    },
    "device_id": {
      "$ref": "#/$defs/identifier"
    },
    "environment_id": {
      "$ref": "#/$defs/identifier"
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/adapterCapability"
      }
    },
    "qualified_bundles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/bundleCapability"
      }
    },
    "capability_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "adapterCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "adapter_id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "sensor",
            "model",
            "robot"
          ]
        },
        "adapter_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "bundleCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "bundle_digest"
      ],
      "properties": {
        "bundle_id": {
          "$ref": "#/$defs/identifier"
        },
        "bundle_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
