{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinyedge.ai/schemas/runtime/runtime-qualified-bundle-v1.schema.json",
  "title": "TinyEdge Runtime qualified bundle v1",
  "description": "Structural projection of one predeclared TinyEdge Runtime v1 sensor/model/robot composition.",
  "$comment": "This schema is a portable structural projection. The tinyedge_runtime Python parser remains authoritative for canonical artifact ordering and uniqueness, matching axes/units/safety fields, and all compatibility semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "bundle_id",
    "execution_strategy",
    "clock_domain",
    "observation_schema_id",
    "action_schema_id",
    "action_axes",
    "action_units",
    "safety_envelope",
    "sensor",
    "model",
    "robot",
    "required_artifacts"
  ],
  "properties": {
    "contract_version": {
      "const": "tinyedge-runtime-qualified-bundle-v1"
    },
    "bundle_id": {
      "$ref": "#/$defs/identifier"
    },
    "execution_strategy": {
      "const": "local_sync_v1"
    },
    "clock_domain": {
      "$ref": "#/$defs/identifier"
    },
    "observation_schema_id": {
      "$ref": "#/$defs/identifier"
    },
    "action_schema_id": {
      "$ref": "#/$defs/identifier"
    },
    "action_axes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "action_units": {
      "$ref": "#/$defs/identifierVector"
    },
    "safety_envelope": {
      "$ref": "#/$defs/safetyPolicy"
    },
    "sensor": {
      "$ref": "#/$defs/sensorAdapter"
    },
    "model": {
      "$ref": "#/$defs/modelAdapter"
    },
    "robot": {
      "$ref": "#/$defs/robotAdapter"
    },
    "required_artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifactRef"
      },
      "contains": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "model"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "boundedNumber": {
      "type": "number",
      "minimum": -1000000000000,
      "maximum": 1000000000000
    },
    "identifierVector": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "numericVector": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/boundedNumber"
      }
    },
    "adapterBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "adapter_id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "sensor",
            "model",
            "robot"
          ]
        },
        "adapter_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "sensorAdapter": {
      "allOf": [
        {
          "$ref": "#/$defs/adapterBase"
        },
        {
          "properties": {
            "kind": {
              "const": "sensor"
            }
          }
        }
      ]
    },
    "modelAdapter": {
      "allOf": [
        {
          "$ref": "#/$defs/adapterBase"
        },
        {
          "properties": {
            "kind": {
              "const": "model"
            }
          }
        }
      ]
    },
    "robotAdapter": {
      "allOf": [
        {
          "$ref": "#/$defs/adapterBase"
        },
        {
          "properties": {
            "kind": {
              "const": "robot"
            }
          }
        }
      ]
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "digest"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "$ref": "#/$defs/identifier"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "safetyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_schema_id",
        "action_dimensions",
        "action_axes",
        "units",
        "lower_limits",
        "upper_limits",
        "max_observation_age_ns",
        "max_action_age_ns",
        "on_violation"
      ],
      "properties": {
        "action_schema_id": {
          "$ref": "#/$defs/identifier"
        },
        "action_dimensions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "action_axes": {
          "allOf": [
            {
              "$ref": "#/$defs/identifierVector"
            },
            {
              "uniqueItems": true
            }
          ]
        },
        "units": {
          "$ref": "#/$defs/identifierVector"
        },
        "lower_limits": {
          "$ref": "#/$defs/numericVector"
        },
        "upper_limits": {
          "$ref": "#/$defs/numericVector"
        },
        "max_observation_age_ns": {
          "$ref": "#/$defs/positiveInteger"
        },
        "max_action_age_ns": {
          "$ref": "#/$defs/positiveInteger"
        },
        "on_violation": {
          "const": "safe_stop"
        }
      }
    }
  }
}
