{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinyedge.ai/schemas/runtime/runtime-action-chunk-v1.schema.json",
  "title": "TinyEdge Runtime action chunk v1",
  "description": "Structural projection of one artifact-bound, time-bounded TinyEdge Runtime v1 action horizon.",
  "$comment": "This schema is a portable structural projection. The tinyedge_runtime Python parser remains authoritative for timestamp ordering, rectangular shape, axis/unit width, committed-prefix bounds, horizon expiry, and all semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "action_id",
    "source_observation_id",
    "action_schema_id",
    "action_axes",
    "units",
    "clock_domain",
    "created_monotonic_ns",
    "valid_from_monotonic_ns",
    "expires_at_monotonic_ns",
    "action_period_ns",
    "values",
    "model_artifact_digest",
    "committed_prefix"
  ],
  "properties": {
    "contract_version": {
      "const": "tinyedge-action-chunk-v1"
    },
    "action_id": {
      "$ref": "#/$defs/identifier"
    },
    "source_observation_id": {
      "$ref": "#/$defs/identifier"
    },
    "action_schema_id": {
      "$ref": "#/$defs/identifier"
    },
    "action_axes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "clock_domain": {
      "$ref": "#/$defs/identifier"
    },
    "created_monotonic_ns": {
      "$ref": "#/$defs/nonnegativeInteger"
    },
    "valid_from_monotonic_ns": {
      "$ref": "#/$defs/nonnegativeInteger"
    },
    "expires_at_monotonic_ns": {
      "$ref": "#/$defs/nonnegativeInteger"
    },
    "action_period_ns": {
      "$ref": "#/$defs/positiveInteger"
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1024,
        "items": {
          "$ref": "#/$defs/boundedNumber"
        }
      }
    },
    "model_artifact_digest": {
      "$ref": "#/$defs/digest"
    },
    "committed_prefix": {
      "$ref": "#/$defs/nonnegativeInteger"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "boundedNumber": {
      "type": "number",
      "minimum": -1000000000000,
      "maximum": 1000000000000
    }
  }
}
